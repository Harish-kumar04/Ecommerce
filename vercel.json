{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "apps": {
      "root": "apps",
      "framework": "fastapi",
      "entrypoint": "api/main.py"
    },
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "apps",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "platform-admin": {
      "root": "apps/platform-admin",
      "framework": "nextjs",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "apps",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "storefront": {
      "root": "apps/storefront",
      "framework": "nextjs",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "apps",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "storefront"
      }
    }
  ]
}
