# Admin Environment Variables

# Backend API URL
NEXT_PUBLIC_API_URL=https://muthamilarignar-api.vercel.app/api/v1
API_URL=https://muthamilarignar-api.vercel.app/api/v1

# Base Path (leave empty if served on root domain)
NEXT_PUBLIC_BASE_PATH=

# Vercel Blob Storage Token for Image Uploads
# Generate from: Vercel Dashboard -> Storage -> Blob -> Create Database -> Copy token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
