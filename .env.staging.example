# ==============================================================================
# Muthamilarignar Pathipagam (முத்தமிழறிஞர் பதிப்பகம்)
# Vercel Multi-Service Staging Environment Variables Template
# ==============================================================================
# Copy the variables below into Vercel Dashboard -> Project -> Settings -> Environment Variables
# (Scope: Preview + Production for temporary staging). NEVER commit real secrets to Git.

# ------------------------------------------------------------------------------
# 1. Core Application & Security (Required for Persistent Staging)
# ------------------------------------------------------------------------------
APP_ENV=staging
DEBUG=false
SECRET_KEY=replace-with-openssl-rand-hex-32-min-64-chars-for-staging
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Disable mandatory TOTP MFA on staging unless explicitly testing authenticator enrollment
MFA_ENABLED=false
AUTO_SEED_DEMO=true

# ------------------------------------------------------------------------------
# 2. Database — Neon Serverless PostgreSQL (Recommended for Persistent Staging)
# ------------------------------------------------------------------------------
# NOTE: If omitted on Vercel, the FastAPI service automatically falls back to an
# ephemeral auto-seeded SQLite database in `/tmp/muthamilarignar_staging.db` (27 books)
# so preview builds boot immediately. Set Neon URLs below for persistent orders/users!
DATABASE_URL_POOLED=postgresql+asyncpg://<user>:<password>@ep-<endpoint>-pooler.<region>.aws.neon.tech/neondb?ssl=require
DATABASE_URL_DIRECT=postgresql+asyncpg://<user>:<password>@ep-<endpoint>.<region>.aws.neon.tech/neondb?ssl=require

# ------------------------------------------------------------------------------
# 3. Frontend Tenant & Routing Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_TENANT=demo-store
# Leave NEXT_PUBLIC_API_URL unset on Vercel Multi-Service!
# All 3 Next.js apps (`storefront`, `admin`, `platform-admin`) automatically use
# Vercel's internal `API_URL` service binding via `/api/v1/[...path]` route handlers.

# ------------------------------------------------------------------------------
# 4. Cache & Rate Limiting — Upstash Serverless Redis (Optional in Staging)
# ------------------------------------------------------------------------------
# When omitted on Vercel, RateLimitMiddleware and IdempotencyMiddleware gracefully
# fall back to bounded in-memory caches with zero connection-timeout latency.
# REDIS_URL=rediss://default:<upstash_password>@<endpoint>.upstash.io:6379

# ------------------------------------------------------------------------------
# 5. Payments — Sandbox / Test Mode Only in Staging!
# ------------------------------------------------------------------------------
# Cash on Delivery (`cod`) works out-of-the-box with zero keys.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_me_webhook_secret

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ------------------------------------------------------------------------------
# 6. Media Storage — AWS S3 / Cloudflare R2 (Optional in Staging)
# ------------------------------------------------------------------------------
# All 27 seeded book covers are already served over HTTPS from S3 (`ap-south-1`).
# S3_BUCKET=muthamilarignar-staging-media
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=replace_me
# S3_SECRET_KEY=replace_me

# ------------------------------------------------------------------------------
# 7. Optional Clerk SSO & Observability
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# SENTRY_DSN=
